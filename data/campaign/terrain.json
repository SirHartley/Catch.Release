{
	# The pond. Merged into the vanilla terrain list, so only our own entries belong here.
	# A terrain spec carries the plugin and sound/music keys only - name, radius, render layers,
	# tags and map icon all come from the plugin.
	"catchrelease_StaticPond":{
		"plugin":"catchrelease.campaign.ponds.terrain.MaskedFishingPondTerrainPlugin",
	},

	# The coherence readout. Invisible terrain covering a whole location, added on demand and
	# expiring on its own - it exists to put a line in the terrain bar, since that bar is built
	# from the terrain the fleet is in and thin reality is not a place you can stand in.
	"catchrelease_coherence_field":{
		"plugin":"catchrelease.campaign.fish.coherence.CoherenceTerrain",
	},
}
