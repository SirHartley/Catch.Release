{
	"catchrelease_Mote":{
		"defaultRadius":20, # used if radius<0 in addCustomEntity()
		"showInCampaign":true, # show in campaign layer
		"showIconOnMap":false,
		"showNameOnMap":false,
		"renderCircleIndicator":false, # make clickable,
		"interactable":false,
		"layers":[ABOVE], # what layer(s) to render in. See CampaignEngineLayers.java for possible values,
		"tags":["catchrelease_mote"],
		"pluginClass":"catchrelease.campaign.fish.entities.FishEntityPlugin"
	},

	# the pond is terrain now - see data/campaign/terrain.json

	"catchrelease_RodMote":{
