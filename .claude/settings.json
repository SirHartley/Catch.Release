{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/dialogue-check.sh\"",
            "timeout": 120,
            "statusMessage": "Running the dialogue check"
          }
        ]
      }
    ]
  }
}
