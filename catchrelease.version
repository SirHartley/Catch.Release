{
    # Master's copy is the online version file. The release action commits the stamped copy back to master,
    # so it always names the newest release and its download.
    "masterVersionFile":"https://raw.githubusercontent.com/SirHartley/Catch.Release/master/catchrelease.version",
    "modName":"Catch.Release",
    "modVersion":
    {
        "major":1,
        "minor":0,
        "patch":"c"
    },

    #Link towards a direct download, fetched from the online version file
    "directDownloadURL":"https://github.com/SirHartley/Catch.Release/releases/download/1.0.c/Catch.Release-1.0.c.zip",

    #Link towards a directly accessible text file, which can be used to display a changelog ingame, is fetched from the online version file.
    "changelogURL":"https://raw.githubusercontent.com/SirHartley/Catch.Release/refs/heads/master/Changelog",
}
