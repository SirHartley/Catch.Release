{
    # All three links must stay releases/latest/download links (triOS and LunaLib read them from the online file).
    # Packaging stamps the version and these links into each release; the release action uploads the named assets.
    "masterVersionFile":"https://github.com/SirHartley/Catch.Release/releases/latest/download/catchrelease.version",
    "modName":"Catch.Release",
    "modVersion":
    {
        "major":1,
        "minor":0,
        "patch":"a"
    },

    # Newest release ZIP, uploaded under a fixed name
    "directDownloadURL":"https://github.com/SirHartley/Catch.Release/releases/latest/download/Catch.Release.zip",

    # Newest release's plain-text changelog
    "changelogURL":"https://github.com/SirHartley/Catch.Release/releases/latest/download/changelog.txt",
}
